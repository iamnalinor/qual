#!/usr/bin/env bash
# Install exact tool versions into the repository, without reading credentials.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
  echo 'bootstrap currently supports Linux x86_64; use that platform for checks' >&2
  exit 1
fi
if [[ $(go env GOVERSION) != go1.27.4 ]]; then
  echo 'Go 1.27.4 is required' >&2
  exit 1
fi
mkdir -p .tools/bin
export GOBIN="$PWD/.tools/bin"
archive_dir=$(mktemp -d)
trap 'rm -rf "$archive_dir"' EXIT
install_archive() {
  local name=$1 url=$2 checksum=$3 member=$4
  curl --fail --silent --show-error --location "$url" -o "$archive_dir/archive"
  echo "$checksum  $archive_dir/archive" | sha256sum --check --status
  tar -xOf "$archive_dir/archive" "$member" > "$GOBIN/$name"
  chmod 755 "$GOBIN/$name"
}
install_archive just \
  https://github.com/casey/just/releases/download/1.43.0/just-1.43.0-x86_64-unknown-linux-musl.tar.gz \
  a1bc93654f31669fd964ea3011a5e5e9676b9b6f8adcd762606e5140632ea72d just
install_archive rg \
  https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-x86_64-unknown-linux-musl.tar.gz \
  4cf9f2741e6c465ffdb7c26f38056a59e2a2544b51f7cc128ef28337eeae4d8e ripgrep-14.1.1-x86_64-unknown-linux-musl/rg
install_archive shellcheck \
  https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz \
  8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198 shellcheck-v0.11.0/shellcheck
install_archive golangci-lint \
  https://github.com/golangci/golangci-lint/releases/download/v2.15.0/golangci-lint-2.15.0-linux-amd64.tar.gz \
  9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea golangci-lint-2.15.0-linux-amd64/golangci-lint
go install github.com/rhysd/actionlint/cmd/actionlint@v1.7.7
go install golang.org/x/vuln/cmd/govulncheck@v1.9.0
go mod download
printf 'Tools installed. Add %s/.tools/bin to PATH.\n' "$PWD"
