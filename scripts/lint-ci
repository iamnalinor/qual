#!/usr/bin/env python3
"""Lint literal GitLab script blocks without interpreting YAML tags or variables."""
from pathlib import Path
import subprocess
import sys

path = Path(__file__).resolve().parents[1] / 'internal/citemplate/templates/gitlab.yml'
lines = path.read_text(encoding='utf-8').splitlines()
blocks = []
current = None
for line in lines:
    if line == '    - |':
        current = []
        blocks.append(current)
    elif current is not None:
        if line.startswith('      '):
            current.append(line[6:])
        elif line.strip():
            current = None
if len(blocks) != 2:
    sys.exit('ci_lint: expected both GitLab authorization/review literal scripts')
for block in blocks:
    subprocess.run(['shellcheck', '--shell=sh', '-'], input='\n'.join(block),
                   text=True, check=True)
